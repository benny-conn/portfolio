# Copy to .env.local (and add the same values in Vercel) to enable the /tour-assistants quote form.
RESEND_API_KEY=
# Where quote requests are delivered (comma-separate for more than one).
TOUR_INQUIRY_TO=
# Optional. Leave unset to use Resend's test sender, which only delivers to the
# address that owns the Resend account. After verifying a domain in Resend, use e.g.
# TOUR_INQUIRY_FROM="Tour assistants <tours@bennyconn.com>"
TOUR_INQUIRY_FROM=
